# BasicTestFlow

main: kit: flow: BasicTestFlow:
{
  entity: "test",
  kind: "basic",
  name: "BasicTestFlow",
  step: [
    {
      input: {
        ref: "test_ref01"
      }

      match: {
        project_id: "project01"
      }

      op: "create"
    }

    {
      match: {
        project_id: "project01"
      }

      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "test_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "test_ref01",
        srcdatavar: "test_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "test01",
        project_id: "project01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-test_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicTestFlow"
}
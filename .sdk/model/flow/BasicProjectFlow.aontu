# BasicProjectFlow

main: kit: flow: BasicProjectFlow:
{
  entity: "project",
  kind: "basic",
  name: "BasicProjectFlow",
  step: [
    {
      i: {
        ref: "project_ref01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "project_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "project_ref01",
        srcdatavar: "project_ref01_data",
        suffix: "_up0",
        textfield: "createdAt"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-project_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "project_ref01",
        srcdatavar: "project_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "project01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-project_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "project_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "project01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "project_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicProjectFlow"
}
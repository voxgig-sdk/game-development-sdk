# BasicAssetFlow

main: kit: flow: BasicAssetFlow:
{
  entity: "asset",
  kind: "basic",
  name: "BasicAssetFlow",
  step: [
    {
      i: {
        ref: "asset_ref01"
      }

      m: {
        project_id: "project01"
      }

      o: "create"
    }

    {
      m: {
        project_id: "project01"
      }

      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "asset_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "asset_ref01",
        srcdatavar: "asset_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "asset01",
        project_id: "project01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-asset_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "asset_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "asset01",
        project_id: "project01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      m: {
        project_id: "project01"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "asset_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicAssetFlow"
}